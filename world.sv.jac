"""Mission Control world graph — SAR operations simulator.

A scenario is generated by `lib/profiles.py` (domain profile + tunables) and
materialised here into an 8x8 `Cell` lattice wired with typed `Adj` edges, a
`Mission` node carrying all mutable run state (multi-victim), and the
graph-persistent `LogEntry` / `Handoff` chains that hang off the Mission so the
incident record survives across requests.

Grid convention (CONTRACT.md v2): origin (0,0) top-left, x = column (-> east),
y = row (v south). NORTH = y-1, SOUTH = y+1, EAST = x+1, WEST = x-1.
Cell kinds: "open" | "hazard" | "staging" | "victim".
"""

import lib.profiles as profiles;

glob GRID_W: int = 8;
glob GRID_H: int = 8;
glob CELL_COUNT: int = 64;
glob MOVES: list[str] = ["NORTH", "SOUTH", "EAST", "WEST"];


# ------------------------------------------------------------------ archetypes
node Cell {
    has x: int = 0,
        y: int = 0,
        kind: str = "open";
}

"""Orthogonal adjacency in the 8x8 lattice (both directions per pair)."""
edge Adj: Cell --> Cell {}


node LogEntry {
    has seq: int = 0,
        tick: int = 0,
        agent: str = "Incident Commander",
        level: str = "info",
        text: str = "";
}


node Handoff {
    # `from` / `to` are Python keywords and cannot be `has` field names (E0067),
    # so they are stored as src/dst and renamed on the wire.
    has seq: int = 0,
        tick: int = 0,
        src: str = "",
        dst: str = "",
        task_id: str = "",
        payload: dict[str, any] = {};
}


node Mission {
    # Which domain + how it was configured (so reset regenerates the same map).
    has profile_id: str = "urban",
        config: dict[str, any] = {},
        objective_text: str = "",
        phase: str = "search";          # "search" | "egress" | "done"

    has status: str = "running",
        tick: int = 0,
        resource: int = 44,
        resource_max: int = 44,
        reserve: float = 1.3,           # air-reserve multiplier (rule of thirds)
        risk: str = "standard";

    has pos_x: int = 0,
        pos_y: int = 0,
        prev_x: int = -1,
        prev_y: int = -1,
        staging_x: int = 0,
        staging_y: int = 7,
        target_x: int = 7,              # CURRENT objective cell (victim or staging)
        target_y: int = 0;

    # Victims still to reach and those already secured, as [x,y] pairs.
    has victims_remaining: list[list[int]] = [],
        victims_rescued: list[list[int]] = [];

    has path: list[list[int]] = [],
        visited: list[list[int]] = [],
        tasks: list[dict[str, any]] = [];

    # Empty dict means "null" on the wire (before the first tick).
    has proposals: dict[str, any] = {},
        verdict: dict[str, any] = {};

    has moves_committed: int = 0,
        vetoes: int = 0,
        llm_calls: int = 0,
        replans: int = 0,
        seq: int = 0;

    # Hazards that exist in ground truth but the planning agents do not know
    # about yet, as "x,y" keys. The Safety Officer reads authoritative live
    # state; IC / Operations / Rescue Team reason over the last-known map. A
    # hazard graduates out the moment a HALT teaches the team about it.
    has unknown_hazards: list[str] = [];

    # Cell entry counts "x,y" -> n, feeding the no_loop livelock guard.
    has visit_counts: dict[str, int] = {};

    # Ticks the IC has taken routing authority off the Rescue Team's proposers
    # and handed to Operations' A* route (the "re-delegate" half of a HALT).
    has defer_ticks: int = 0;
}


edge Holds: Mission --> Cell {}
edge Logged: Mission --> LogEntry {}
edge Handed: Mission --> Handoff {}


# ------------------------------------------------------------------- accessors
"""Mission clock string derived from the tick count."""
def clockstr(tick: int) -> str {
    mm = tick // 60;
    ss = tick % 60;
    return f"T+{mm:02d}:{ss:02d}";
}


"""Every Cell of the mission's grid, in creation (row-major) order."""
def mission_cells(m: Mission) -> list[Cell] {
    return [m ->:Holds:->];
}


"""Row-major list of 64 kind strings -- exactly the `grid.cells` wire format."""
def grid_cells(m: Mission) -> list[str] {
    out: list[str] = ["open" for _i in range(CELL_COUNT)];
    for c in mission_cells(m) {
        idx = c.y * GRID_W + c.x;
        if idx >= 0 and idx < CELL_COUNT {
            out[idx] = c.kind;
        }
    }
    return out;
}


"""Ground-truth passability (hazard = blocked). A* / rules use this."""
def passable_cells(m: Mission) -> list[str] {
    # Everything that is not a hazard is traversable, including staging/victim.
    return [("hazard" if k == "hazard" else "open") for k in grid_cells(m)];
}


"""The grid as the *planning* agents believe it to be.

Identical to ground truth except hazards the team has not discovered yet still
read as passable. This is the map IC / Operations / Rescue Team / policy net
reason over; the Safety Officer always checks ground truth. The gap between the
two is what a HALT exists to catch.
"""
def believed_cells(m: Mission) -> list[str] {
    out = passable_cells(m);
    for key in m.unknown_hazards {
        parts = key.split(",");
        if len(parts) == 2 {
            bx = int(parts[0]);
            by = int(parts[1]);
            idx = by * GRID_W + bx;
            if idx >= 0 and idx < CELL_COUNT {
                out[idx] = "open";
            }
        }
    }
    return out;
}


"""The Cell node at (x, y), or None when out of bounds."""
def cell_at(m: Mission, x: int, y: int) -> Cell | None {
    for c in mission_cells(m) {
        if c.x == x and c.y == y {
            return c;
        }
    }
    return None;
}


"""Orthogonal neighbours of a cell, walked over the typed Adj lattice."""
def cell_neighbors(c: Cell) -> list[Cell] {
    return [c ->:Adj:->];
}


# ------------------------------------------------------------ transcript nodes
def add_log(m: Mission, agent: str, level: str, text: str) {
    m.seq = m.seq + 1;
    e = LogEntry(seq=m.seq, tick=m.tick, agent=agent, level=level, text=text);
    m +>:Logged():+> e;
}


def add_handoff(m: Mission, src: str, dst: str, task_id: str, payload: dict[str, any]) {
    m.seq = m.seq + 1;
    h = Handoff(seq=m.seq, tick=m.tick, src=src, dst=dst, task_id=task_id, payload=payload);
    m +>:Handed():+> h;
}


"""Log entries oldest-first, as plain wire dicts (with a derived clock)."""
def log_list(m: Mission) -> list[dict[str, any]] {
    entries = [m ->:Logged:->];
    ordered = sorted(entries, key=lambda (e: LogEntry) -> int { return e.seq; });
    out: list[dict[str, any]] = [];
    for e in ordered {
        out.append({
            "tick": e.tick,
            "clock": clockstr(e.tick),
            "agent": e.agent,
            "level": e.level,
            "text": e.text
        });
    }
    return out;
}


"""Handoffs oldest-first, as plain wire dicts (src/dst renamed to from/to)."""
def handoff_list(m: Mission) -> list[dict[str, any]] {
    entries = [m ->:Handed:->];
    ordered = sorted(entries, key=lambda (h: Handoff) -> int { return h.seq; });
    out: list[dict[str, any]] = [];
    for h in ordered {
        out.append({
            "tick": h.tick,
            "from": h.src,
            "to": h.dst,
            "task_id": h.task_id,
            "payload": h.payload
        });
    }
    return out;
}


# ------------------------------------------------------------- world lifecycle
"""The ICS task board Operations starts every mission with."""
def seed_tasks() -> list[dict[str, any]] {
    return [
        {"id": "t1", "desc": "Plan search route to nearest victim", "owner": "Operations", "state": "done"},
        {"id": "t2", "desc": "Advance one cell along route", "owner": "Rescue Team", "state": "active"},
        {"id": "t3", "desc": "Re-task / re-route on Safety HALT", "owner": "Incident Commander", "state": "pending"}
    ];
}


"""Tear down any existing mission subgraph (cells, logs, handoffs, mission)."""
def destroy_world() {
    for m in [root -->[?:Mission]] {
        for c in [m ->:Holds:->] { del c; }
        for e in [m ->:Logged:->] { del e; }
        for h in [m ->:Handed:->] { del h; }
        del m;
    }
}


"""Materialise a generated scenario (lib/profiles) into the world graph."""
def build_from_scenario(sc: dict[str, any], config: dict[str, any]) -> Mission {
    destroy_world();

    cells = sc["cells"] as list;
    staging = sc["staging"] as list;
    victims = sc["victims"] as list;
    resource = sc["resource"] as int;
    reserve = sc["reserve"] as float;
    risk = sc["risk"] as str;
    pid = sc["profile"] as str;

    sx = staging[0] as int;
    sy = staging[1] as int;

    first = victims[0] as list;
    tx = first[0] as int;
    ty = first[1] as int;

    vcount = len(victims);
    otext = f"Reach {vcount} {profiles.profile(pid)['objective_noun']}(s) and egress to staging.";

    m = (root ++> Mission(
        profile_id=pid,
        config=config,
        objective_text=otext,
        phase="search",
        status="running",
        tick=0,
        resource=resource,
        resource_max=resource,
        reserve=reserve,
        risk=risk,
        pos_x=sx,
        pos_y=sy,
        prev_x=-1,
        prev_y=-1,
        staging_x=sx,
        staging_y=sy,
        target_x=tx,
        target_y=ty,
        victims_remaining=[(v as list) for v in victims],
        victims_rescued=[],
        path=[],
        visited=[[sx, sy]],
        tasks=seed_tasks(),
        proposals={},
        verdict={}
    )) as Mission;

    # Row-major construction so Holds-edge order == wire order.
    lattice: list[Cell] = [];
    for y in range(GRID_H) {
        for x in range(GRID_W) {
            kind = cells[y * GRID_W + x] as str;
            c = Cell(x=x, y=y, kind=kind);
            m +>:Holds():+> c;
            lattice.append(c);
        }
    }

    # 4-connected Adj lattice (one directed edge each way per pair).
    for y in range(GRID_H) {
        for x in range(GRID_W) {
            src = lattice[y * GRID_W + x];
            if x + 1 < GRID_W {
                dst = lattice[y * GRID_W + x + 1];
                src +>:Adj():+> dst;
                dst +>:Adj():+> src;
            }
            if y + 1 < GRID_H {
                dsty = lattice[(y + 1) * GRID_W + x];
                src +>:Adj():+> dsty;
                dsty +>:Adj():+> src;
            }
        }
    }

    return m;
}


"""The live Mission, building a default urban scenario on first touch."""
def get_mission() -> Mission {
    existing = [root -->[?:Mission]];
    if len(existing) > 0 {
        return existing[0];
    }
    sc = profiles.generate_scenario("urban", {}, 7) as dict;
    return build_from_scenario(sc, {"profile": "urban", "tunables": {}, "seed": 7});
}
