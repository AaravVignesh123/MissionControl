# Mission Control - environment
#
# Copy to `.env` and fill in, or just export the vars in your shell.
# EVERYTHING BELOW IS OPTIONAL. With no keys at all the whole system still
# runs: brain.sv.jac falls back to byLLM's MockLLM, and the UI badge reads
# "mock" instead of "live".

# ---------------------------------------------------------------------------
# The one switch that matters
# ---------------------------------------------------------------------------
# Set this and brain_mode() reports "live" and the Commander / Executor
# reasoning runs against a real Anthropic model (claude-sonnet-4-6).
# Leave it unset / empty and brain_mode() reports "mock".
# byLLM reads it directly; do not put the key in jac.toml.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Point litellm at a proxy or gateway instead of api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Override the project default model for one shell (byLLM built-in).
# BYLLM_DEFAULT_MODEL=claude-sonnet-4-6
